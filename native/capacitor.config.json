{
  "appId": "cl.koachclub.app",
  "appName": "KOACH",
  "webDir": "www",
  "backgroundColor": "#000000",
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LocalNotifications": {
      "iconColor": "#3EC6B0"
    }
  }
}