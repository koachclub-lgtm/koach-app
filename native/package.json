{
  "name": "koach-native",
  "private": true,
  "version": "1.0.0",
  "description": "KOACH v1 nativa (Capacitor): empaqueta app.html con cámara, QR, push y modo sin conexión",
  "scripts": {
    "puente": "esbuild src/koach-native.js --bundle --format=iife --minify --target=es2019 --outfile=koach-native.js",
    "web": "npm run puente && node sync-web.mjs",
    "sync": "npm run web && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-mlkit/barcode-scanning": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "capacitor-health": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.28.2"
  }
}
