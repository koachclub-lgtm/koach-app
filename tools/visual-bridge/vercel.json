{
  "rewrites": [
    {
      "source": "/mcp/:t",
      "destination": "/api/mcp?t=:t"
    },
    {
      "source": "/lote/:t",
      "destination": "/api/mcp?t=:t&lote=1"
    },
    {
      "source": "/lote/:t/:g",
      "destination": "/api/mcp?t=:t&lote=1&g=:g"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 300,
      "includeFiles": "seed/**"
    }
  }
}