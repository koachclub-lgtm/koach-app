{
  "redirects": [
    {
      "source": "/coach.html",
      "has": [
        {
          "type": "host",
          "value": "koach-app-three.vercel.app"
        }
      ],
      "destination": "https://dashboard.koachclub.cl/coach.html",
      "permanent": false
    },
    {
      "source": "/coach",
      "has": [
        {
          "type": "host",
          "value": "koach-app-three.vercel.app"
        }
      ],
      "destination": "https://dashboard.koachclub.cl/coach.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "has": [
        {
          "type": "host",
          "value": "koach-app-three.vercel.app"
        }
      ],
      "destination": "https://dashboard.koachclub.cl/coach.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "koach-app-three.vercel.app"
        }
      ],
      "destination": "https://app.koachclub.cl/:path*",
      "permanent": false
    },
    {
      "source": "/coach.html",
      "has": [
        {
          "type": "host",
          "value": "app.koachclub.cl"
        }
      ],
      "destination": "https://dashboard.koachclub.cl/coach.html",
      "permanent": false
    },
    {
      "source": "/app.html",
      "has": [
        {
          "type": "host",
          "value": "dashboard.koachclub.cl"
        }
      ],
      "destination": "https://app.koachclub.cl/app.html",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/inicio",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/socio",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/socio/:path*",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/coach",
      "destination": "/coach.html",
      "permanent": false
    },
    {
      "source": "/coach/:path*",
      "destination": "/coach.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/coach.html",
      "permanent": false
    },
    {
      "source": "/sala",
      "destination": "/coach.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}